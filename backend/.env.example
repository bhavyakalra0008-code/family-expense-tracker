# ==================================================
# LEDGER — Environment Configuration Template
# ==================================================
#
# IMPORTANT SECURITY NOTES:
#
#   This file (.env.example) is SAFE TO COMMIT to Git.
#   It contains only placeholder values — no real secrets.
#
#   NEVER commit the real backend/.env file.
#   backend/.env is listed in .gitignore and must remain LOCAL-ONLY.
#
#   For LOCAL development:
#     cp .env.example .env
#     Fill in real local credentials in .env
#
#   For AWS (EC2/ECS/Lambda) production:
#     Store DATABASE_URL and JWT_SECRET in:
#       - AWS Secrets Manager, or
#       - AWS SSM Parameter Store (SecureString)
#     Inject them as environment variables at runtime.
#     Never put real credentials in source code.
#
# ==================================================

# ----- Server -----
PORT=4000
NODE_ENV=development

# ----- Database (PostgreSQL via Prisma) -----
# Replace USER, PASSWORD, HOST, and DATABASE with your actual values.
# For local development using docker-compose: HOST is usually "localhost"
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public

# ----- JWT Authentication -----
# Generate a secure random secret for production, e.g.:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=REPLACE_WITH_A_SECURE_RANDOM_SECRET_64_CHARS_MINIMUM
JWT_EXPIRES_IN=7d

# ----- CORS -----
# In production, set this to your actual frontend domain, e.g.:
# CORS_ORIGIN=https://your-app.example.com
CORS_ORIGIN=http://localhost:4000

# ----- Password Reset Email (SMTP) -----
# Leave empty to disable password reset emails locally.
# Configure in production using AWS SES or another SMTP provider.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Ledger <no-reply@example.com>
PASSWORD_RESET_URL=http://localhost:4000/reset-password
